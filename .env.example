# Runtime
APP_ENV=local
APP_VERSION=0.1.0
LOG_LEVEL=INFO
API_PORT=8000
WEB_PORT=3000

# Database
POSTGRES_DB=ai_governance
POSTGRES_USER=governance
POSTGRES_PASSWORD=governance-local-only
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://governance:governance-local-only@localhost:5432/ai_governance
AUTO_CREATE_SCHEMA=false

# Browser/API connection
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_AUTH_MODE=local
NEXT_PUBLIC_ENTRA_CLIENT_ID=
NEXT_PUBLIC_ENTRA_TENANT_ID=
NEXT_PUBLIC_ENTRA_API_SCOPE=
NEXT_PUBLIC_DEMO_READ_ONLY=false
NEXT_PUBLIC_DEPLOYMENT_LABEL=Ambiente local
NEXT_PUBLIC_GIT_SHA=
CORS_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=true

# Authentication: local mode remains authenticated through explicit dev headers.
OIDC_ENABLED=false
DEV_AUTH_ENABLED=true
OIDC_ISSUER=
OIDC_JWKS_URL=
OIDC_AUDIENCE=ai-governance-api
OIDC_ALGORITHMS=RS256
OIDC_GROUPS_CLAIM=governance_areas
OIDC_ADMIN_CLAIM=governance_admin
OIDC_IDENTITY_MODE=subject
OIDC_ALLOWED_TENANT_IDS=
OIDC_GUEST_APPROVALS_ENABLED=false
OIDC_ENTRA_APP_ROLES_CLAIM=roles
OIDC_ENTRA_GROUPS_CLAIM=groups
OIDC_JWKS_TIMEOUT_SECONDS=2
OIDC_JWKS_CACHE_SECONDS=300
OIDC_CLOCK_SKEW_SECONDS=30
OIDC_MAX_TOKEN_LENGTH=16384

# Optional Microsoft Graph enrichment through API-side On-Behalf-Of delegation.
MICROSOFT_GRAPH_ENABLED=false
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=
MICROSOFT_GRAPH_TIMEOUT_SECONDS=5
MICROSOFT_GRAPH_MAX_PAGES=20
MICROSOFT_GRAPH_MAX_ATTEMPTS=3
MICROSOFT_GRAPH_BACKOFF_BASE_SECONDS=0.25
MICROSOFT_GRAPH_MAX_RETRY_DELAY_SECONDS=2
MICROSOFT_GRAPH_MAX_RETRY_AFTER_SECONDS=300
MICROSOFT_GRAPH_MAX_RESPONSE_BYTES=1048576
DIRECTORY_AUTHORIZATION_CATALOG_PATH=
DIRECTORY_AUTHORIZATION_CACHE_TTL_SECONDS=60

# Optional policy-model-router runtime enforcement. Keys map exact reviewed agent names to secrets.
POLICY_MODEL_ROUTER_ENABLED=false
POLICY_MODEL_ROUTER_BASE_URL=http://host.docker.internal:8082
POLICY_MODEL_ROUTER_API_KEYS_JSON={}
POLICY_MODEL_ROUTER_TIMEOUT_SECONDS=2
POLICY_MODEL_ROUTER_MAX_RESPONSE_BYTES=262144

# Reproducible local Keycloak validation only
KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=local-only-admin
OIDC_TEST_CLIENT_ID=ai-governance-cli
OIDC_TEST_USERNAME=security.reviewer
OIDC_TEST_PASSWORD=local-only
OIDC_TEST_EXPECTED_AREA=security

# Audit integrity (replace with a secret outside local/test environments)
AUDIT_HASH_SALT=local-development-only
CONTROL_CATALOG_PATH=

# Secure evidence upload
EVIDENCE_MAX_BYTES=10485760
EVIDENCE_REQUEST_OVERHEAD_BYTES=65536
EVIDENCE_ALLOWED_CONTENT_TYPES=application/pdf,image/png,image/jpeg,text/plain,text/csv,application/json
MALWARE_SCANNER_HOST=localhost
MALWARE_SCANNER_PORT=3310
MALWARE_SCANNER_CONNECT_TIMEOUT_SECONDS=2
MALWARE_SCANNER_SCAN_TIMEOUT_SECONDS=30
CLAMAV_PORT=3310

# S3-compatible object storage (local MinIO defaults only)
OBJECT_STORAGE_ENDPOINT_URL=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=governance-evidence
OBJECT_STORAGE_ACCESS_KEY=governance
OBJECT_STORAGE_SECRET_KEY=governance-local-only
OBJECT_STORAGE_AUTO_CREATE_BUCKET=true
OBJECT_STORAGE_SERVER_SIDE_ENCRYPTION=
# Optional least-privilege credentials dedicated to backup operations
BACKUP_OBJECT_STORAGE_ENDPOINT_URL=
BACKUP_OBJECT_STORAGE_ACCESS_KEY=
BACKUP_OBJECT_STORAGE_SECRET_KEY=
BACKUP_OBJECT_STORAGE_SESSION_TOKEN=
BACKUP_DATABASE_COMMAND_TIMEOUT_SECONDS=1800
BACKUP_S3_CONNECT_TIMEOUT_SECONDS=3
BACKUP_S3_READ_TIMEOUT_SECONDS=30
BACKUP_S3_MAX_ATTEMPTS=3
MINIO_ROOT_USER=governance
MINIO_ROOT_PASSWORD=governance-local-only
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
